{
  "permissions": {
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/allow-safe-commands.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
